# Copy to .env next to docker-compose.yml / docker-compose.prod.yaml.

# Port the frontend listens on. In docker-compose.prod.yaml it is bound to
# 127.0.0.1 only, for a reverse proxy (Caddy) on the same host.
PORT=8080

# Postgres password. Required by docker-compose.prod.yaml; the dev compose
# falls back to "polycode".
POSTGRES_PASSWORD=change-me

# Development only, never on a server: extra address ranges the network
# proxy treats as public. Needed when a VPN with "fake IP" DNS resolves every
# public host into 198.18.0.0/15. Loopback and private ranges stay blocked.
# PROXY_ALLOW_CIDRS=198.18.0.0/15
